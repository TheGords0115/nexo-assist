# --- Modelo (obrigatório) ---
# Chave da API da Anthropic. Crie em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo usado pelo agent (formato provedor/modelo do Mastra)
NEXO_MODEL=anthropic/claude-haiku-5-5

# --- Serviço de chamados simulado ---
TICKETS_URL=http://127.0.0.1:4001
TICKETS_PORT=4001
# Chave compartilhada entre a aplicação e o serviço (troque por qualquer texto aleatório)
TICKETS_SERVICE_KEY=troque-esta-chave
# Instabilidade simulada do sistema legado (0 desliga)
TICKETS_FAILURE_RATE=0.08
TICKETS_OUTAGE_RATE=0.02
TICKETS_OUTAGE_MS=4000

# --- Aplicação web ---
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres)
SESSION_SECRET=troque-este-segredo-por-um-texto-longo-e-aleatorio
# Limite de mensagens do funcionário por sessão de conversa
CHAT_MESSAGE_LIMIT=30
